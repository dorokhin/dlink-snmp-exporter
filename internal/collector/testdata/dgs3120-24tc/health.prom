# HELP dlink_cpu_utilization_ratio CPU utilization averaged over period.
# TYPE dlink_cpu_utilization_ratio gauge
dlink_cpu_utilization_ratio{period="1m"} 0.42
dlink_cpu_utilization_ratio{period="5m"} 0.26
dlink_cpu_utilization_ratio{period="5s"} 0.19
# HELP dlink_fan_failed 1 when the fan reports a failure.
# TYPE dlink_fan_failed gauge
dlink_fan_failed{fan="1",position="right",unit="1"} 0
dlink_fan_failed{fan="2",position="right",unit="1"} 0
# HELP dlink_fan_speed_rpm Fan speed.
# TYPE dlink_fan_speed_rpm gauge
dlink_fan_speed_rpm{fan="1",position="right",unit="1"} 3000
dlink_fan_speed_rpm{fan="2",position="right",unit="1"} 3000
# HELP dlink_fan_status Fan status; state set, 1 for the current state (speed_0: idle because it is cool).
# TYPE dlink_fan_status gauge
dlink_fan_status{fan="1",position="right",status="fail",unit="1"} 0
dlink_fan_status{fan="1",position="right",status="other",unit="1"} 0
dlink_fan_status{fan="1",position="right",status="speed_0",unit="1"} 0
dlink_fan_status{fan="1",position="right",status="speed_high",unit="1"} 0
dlink_fan_status{fan="1",position="right",status="speed_low",unit="1"} 1
dlink_fan_status{fan="1",position="right",status="speed_middle",unit="1"} 0
dlink_fan_status{fan="1",position="right",status="working",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="fail",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="other",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="speed_0",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="speed_high",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="speed_low",unit="1"} 1
dlink_fan_status{fan="2",position="right",status="speed_middle",unit="1"} 0
dlink_fan_status{fan="2",position="right",status="working",unit="1"} 0
# HELP dlink_memory_total_bytes Memory size by type (dram, flash).
# TYPE dlink_memory_total_bytes gauge
dlink_memory_total_bytes{type="dram",unit="1"} 1.34217728e+08
dlink_memory_total_bytes{type="flash",unit="1"} 3.0585856e+07
# HELP dlink_memory_used_bytes Memory in use by type (dram, flash).
# TYPE dlink_memory_used_bytes gauge
dlink_memory_used_bytes{type="dram",unit="1"} 1.3367296e+08
dlink_memory_used_bytes{type="flash",unit="1"} 1.3996032e+07
# HELP dlink_power_supply_status Power supply status; state set, 1 for the current state. An absent redundant supply usually reports fail.
# TYPE dlink_power_supply_status gauge
dlink_power_supply_status{psu="1",status="connect",unit="1"} 0
dlink_power_supply_status{psu="1",status="disconnect",unit="1"} 0
dlink_power_supply_status{psu="1",status="fail",unit="1"} 0
dlink_power_supply_status{psu="1",status="low_voltage",unit="1"} 0
dlink_power_supply_status{psu="1",status="other",unit="1"} 0
dlink_power_supply_status{psu="1",status="over_current",unit="1"} 0
dlink_power_supply_status{psu="1",status="working",unit="1"} 1
dlink_power_supply_status{psu="2",status="connect",unit="1"} 0
dlink_power_supply_status{psu="2",status="disconnect",unit="1"} 0
dlink_power_supply_status{psu="2",status="fail",unit="1"} 1
dlink_power_supply_status{psu="2",status="low_voltage",unit="1"} 0
dlink_power_supply_status{psu="2",status="other",unit="1"} 0
dlink_power_supply_status{psu="2",status="over_current",unit="1"} 0
dlink_power_supply_status{psu="2",status="working",unit="1"} 0
# HELP dlink_temperature_celsius Shelf temperature.
# TYPE dlink_temperature_celsius gauge
dlink_temperature_celsius{unit="1"} 31
# HELP dlink_temperature_threshold_celsius Shelf temperature alarm thresholds.
# TYPE dlink_temperature_threshold_celsius gauge
dlink_temperature_threshold_celsius{type="high",unit="1"} 79
dlink_temperature_threshold_celsius{type="low",unit="1"} 11
